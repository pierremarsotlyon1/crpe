# Local development only. Never reuse these credentials in production.
POSTGRES_PORT=55433
API_PORT=8080
WEB_PORT=3000
S3_PORT=9000
API_INTERNAL_URL=http://localhost:8080
DATABASE_URL=postgres://crpe:crpe_local@localhost:55433/crpe?sslmode=disable
DATABASE_MAX_CONNS=5
HTTP_ADDR=:8080
SALES_ENABLED=false
# Future upload adapters will use these; no upload feature is implemented yet.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=crpe-development
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=crpe_local
S3_SECRET_ACCESS_KEY=crpe_local_secret
# For a physical phone, replace localhost with your development machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8080
