# Local development only. Never reuse these credentials in production.
POSTGRES_PORT=55433
API_PORT=8080
WEB_PORT=3000
S3_PORT=9000
API_INTERNAL_URL=http://localhost:8080
DATABASE_URL=postgres://crpe:crpe_local@localhost:55433/crpe?sslmode=disable
DATABASE_MAX_CONNS=5
HTTP_ADDR=:8080
SALES_ENABLED=false
PUBLIC_WEB_URL=http://localhost:3000
MOBILE_AUTH_URL=crpemaths://auth
# Local teacher login; messages are captured by Mailpit, never delivered externally.
ADMIN_EMAILS=enseignante@example.test
MAILPIT_PORT=8025
SMTP_PORT=11025
SMTP_ADDR=localhost:11025
SMTP_FROM=bonjour@example.test
SMTP_ALLOW_PLAINTEXT=true
# Private documents and cleaned JPEG/PNG copies use this object store.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=crpe-development
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=crpe_local
S3_SECRET_ACCESS_KEY=crpe_local_secret
# Explicit local deterministic correction; use provider with real LLM settings.
CORRECTION_MODE=local
CORRECTION_DAILY_LIMIT=20
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
# Optional price estimates in USD per million tokens. Blank means unknown cost.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
STT_ENDPOINT=
STT_MODEL=
STT_API_KEY=
TTS_ENDPOINT=
TTS_MODEL=
TTS_API_KEY=
TTS_VOICE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PLANS_JSON=[]
# Store credentials are server-only; leave the entire provider group blank locally.
# Set explicitly to Production or Sandbox in a payment-enabled deployment.
STORE_ENVIRONMENT=
STORE_PRODUCTS_JSON=[]
STORE_REFERENCE_KEY=
APPLE_STORE_BUNDLE_ID=
APPLE_STORE_APP_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_ISSUER_ID=
APPLE_STORE_PRIVATE_KEY=
APPLE_STORE_ENVIRONMENT=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_ENVIRONMENT=
GOOGLE_PLAY_PUSH_AUDIENCE=
GOOGLE_PLAY_PUSH_EMAIL=
GOOGLE_PLAY_PUSH_SUBSCRIPTION=
