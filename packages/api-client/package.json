{
  "name": "@crpe/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/api/openapi.yaml -o src/schema.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
