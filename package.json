{
  "name": "crpe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "web",
    "packages/api-client"
  ],
  "scripts": {
    "lint": "biome check . && redocly lint backend/api/openapi.yaml",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "generate": "npm run generate --workspace @crpe/api-client",
    "generate:check": "node scripts/check-generated.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@redocly/cli": "2.79.0"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
